# FineData Environment Configuration
# Copy this file to .env and update values for your environment

# Database
POSTGRES_DB=finedata
POSTGRES_USER=finedata
POSTGRES_PASSWORD=finedata_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Stripe (Get from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# AWS S3 (Optional - for dataset storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_DATASETS=finedata-datasets
S3_BUCKET_SAMPLES=finedata-samples

# Hugging Face (Optional - for dataset publishing)
HF_TOKEN=your_huggingface_token
HF_ORG_NAME=your_organization_name

# Email (Optional - for notifications)
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@finedata.example.com

# OpenAI (Optional - for ontology generation)
OPENAI_API_KEY=your_openai_api_key

# Application Settings
DEBUG=true
SECRET_KEY=change_this_secret_key_in_production

# Slurm Configuration (for production)
SLURM_CLUSTER_NAME=production-cluster
BENCHMARK_SAMPLE_SIZE=1000000
MAX_BENCHMARK_CONCURRENT=5