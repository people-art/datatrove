# FineData Development Environment Variables
# Copy this file to .env and fill in your actual values

# ==========================================
# REQUIRED FOR DEVELOPMENT
# ==========================================

# HuggingFace Configuration
HF_TOKEN=your-huggingface-token-here
HF_USERNAME=your-huggingface-username
HF_ORG_NAME=your-organization-name

# AWS S3 Configuration (optional for development)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_DATASETS=finedata-dev-datasets
S3_BUCKET_SAMPLES=fineweb-data

# ==========================================
# FEISHU SMTP CONFIGURATION (REQUIRED)
# ==========================================
# Feishu SMTP settings for contacts@agenticeconomics.org
# Sending limits: 200 emails/100 seconds, 100 emails/day per sender

SMTP_SERVER=smtp.feishu.cn
SMTP_PORT=587
SMTP_USERNAME=contacts@agenticeconomics.org
SMTP_PASSWORD=ZHlpHYH3GorXyywN
FROM_EMAIL=contacts@agenticeconomics.org
FROM_NAME=FineData

# Alternative Gmail SMTP (uncomment to use Gmail instead):
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-gmail@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# FROM_EMAIL=noreply@finedata.ai

# ==========================================
# OPTIONAL CONFIGURATIONS
# ==========================================

# SendGrid (alternative to SMTP)
SENDGRID_API_KEY=your-sendgrid-api-key

# OpenAI API Key (for ontology generation)
OPENAI_API_KEY=your-openai-api-key

# Moonshot AI (alternative LLM provider)
MOONSHOT_API_KEY=your-moonshot-api-key

# ==========================================
# PRODUCTION OVERRIDES
# ==========================================
# Uncomment and modify for production deployment

# DEBUG=false
# SECRET_KEY=your-production-secret-key
# POSTGRES_SERVER=your-production-db-host
# POSTGRES_USER=your-production-db-user
# POSTGRES_PASSWORD=your-production-db-password
# REDIS_HOST=your-production-redis-host