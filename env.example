# Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# AWS Configuration (for Common Crawl access)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1

# HuggingFace Configuration (for dataset upload)
HF_USERNAME=your_huggingface_username
HF_TOKEN=hf_your_huggingface_token

# Instructions:
# 1. Copy this file to .env: cp env.example .env
# 2. Fill in your actual values
# 3. Get HF_USERNAME from: https://huggingface.co/settings/profile
# 4. Get HF_TOKEN from: https://huggingface.co/settings/tokens
#    Make sure to grant "Write" permissions for dataset creation
