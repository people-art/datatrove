# Database
POSTGRES_SERVER=localhost
POSTGRES_USER=finedata
POSTGRES_PASSWORD=password
POSTGRES_DB=finedata
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_DATASETS=finedata-datasets
S3_BUCKET_SAMPLES=finedata-samples

# Hugging Face
HF_TOKEN=
HF_ORG_NAME=

# Email (SendGrid)
SENDGRID_API_KEY=
EMAIL_FROM=noreply@finedata.example.com

# OpenAI
OPENAI_API_KEY=

# Application
DEBUG=true
SECRET_KEY=your-secret-key-here

# FineWebData Integration
FINEDATA_SLURM_CONFIG_PATH=/home/ubuntu/datatrove/finewebdata/config.yaml
FINEDATA_SLURM_SETUP_SCRIPT=/home/ubuntu/datatrove/finewebdata/setup_slurm_cluster.sh
FINEDATA_HF_UPLOAD_SCRIPT=/home/ubuntu/datatrove/finewebdata/publish_to_hf.sh
FINEDATA_BENCHMARK_SAMPLE_SIZE=1000000
FINEDATA_PRODUCTION_TIMEOUT_HOURS=48
